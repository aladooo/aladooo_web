---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import { SITE, homeProducts, labProducts } from "../data/products";

const featured = homeProducts.find((p) => p.featured);
const rest = homeProducts.filter((p) => !p.featured);
const featuredGithub = featured?.links.find((l) => l.label === "GitHub");
const download = featured?.links.find((l) => l.download);
---

<Base title={`${SITE.name} · ${SITE.tagline}`} description={SITE.tagline}>
  <section class="hero">
    <span class="orange-bar" aria-hidden="true"></span>
    <h1 class="tagline">{SITE.tagline}</h1>
    <p class="sub">
      {SITE.name} · 全栈开发者，一线 AI 观察者与实践者。
    </p>
    <p class="now">
      <span class="now-label">Now</span>{SITE.now}
    </p>
  </section>

  {featured && (
    <section class="featured">
      <h2 class="section-title">主推</h2>
      <a class="feature-card" href={featured.detail}>
        <div class="feature-head">
          <h3 class="feature-name">{featured.name}</h3>
          <span class="status status-maintain">{featured.status}</span>
        </div>
        <p class="feature-tagline">{featured.tagline}</p>
        <div class="feature-actions">
          {download && (
            <span class="btn btn-primary">下载 orangeink.html</span>
          )}
          {featuredGithub && (
            <span class="btn">GitHub ↗</span>
          )}
          <span class="feature-more">了解详情 →</span>
        </div>
      </a>
    </section>
  )}

  {rest.length > 0 && (
    <section class="works">
      <h2 class="section-title">在做</h2>
      <div class="grid">
        {rest.map((product) => <Card product={product} />)}
      </div>
    </section>
  )}

  {labProducts.length > 0 && (
    <section class="lab">
      <h2 class="section-title">实验室 Lab</h2>
      <p class="lab-note">放进来跑的想法，不承诺维护。</p>
      <div class="grid">
        {labProducts.map((product) => <Card product={product} />)}
      </div>
    </section>
  )}

  <section class="contact-hint">
    <p>
      联系：
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <span class="dot">·</span>
      <a href="/about/">About</a>
    </p>
  </section>

  <script>
    // KDay 天数计数：按 data-kday-start（起始日）计算「今天是第 N 天」
    document.querySelectorAll<HTMLElement>("[data-kday-start]").forEach((el) => {
      const start = new Date(el.dataset.kdayStart + "T00:00:00+08:00");
      const days = Math.floor((Date.now() - start.getTime()) / 86400000) + 1;
      if (days > 0) el.textContent = String(days);
    });
  </script>
</Base>

<style>
  .hero {
    padding: 0 0 40px;
  }

  .tagline {
    margin: 16px 0 10px;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1.35;
  }

  @media (min-width: 640px) {
    .tagline {
      font-size: 32px;
    }
  }

  .sub {
    margin: 0 0 8px;
    color: var(--muted);
  }

  .now {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }

  .now-label {
    display: inline-block;
    margin-right: 10px;
    padding: 1px 8px;
    border-radius: 3px;
    background: var(--accent);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .featured {
    margin-bottom: 40px;
  }

  /* 主推卡：方案A intro 模块语言（米色底 + 顶部 3px 亮橙条） */
  .feature-card {
    display: block;
    background: var(--module);
    border-top: 3px solid var(--accent);
    border-radius: 0 8px 8px 8px;
    padding: 24px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .feature-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(28, 25, 23, 0.08);
    color: inherit;
    text-decoration: none;
  }

  .feature-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
  }

  .feature-name {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
  }

  .feature-card:hover .feature-name {
    color: var(--ink-title);
  }

  .status {
    font-size: 12px;
    padding: 2px 10px;
    border-radius: 99px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .status-maintain {
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .feature-tagline {
    margin: 0 0 20px;
    color: var(--ink);
    max-width: 640px;
  }

  .feature-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 8px 20px;
    border-radius: 8px;
    border: 1px solid var(--ink-title);
    color: var(--ink-title);
    font-weight: 600;
    font-size: 15px;
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .feature-more {
    margin-left: auto;
    color: var(--muted);
    font-size: 14px;
  }

  .works,
  .lab {
    margin-bottom: 40px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .lab-note {
    margin: -8px 0 16px;
    color: var(--muted);
    font-size: 14px;
  }

  .contact-hint {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 15px;
  }

  .contact-hint a:hover {
    color: var(--accent);
  }

  .dot {
    margin: 0 8px;
    color: var(--border);
  }
</style>
