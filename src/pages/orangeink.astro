---
import Base from "../layouts/Base.astro";

const title = "橙墨 orangeink · 单文件公众号排版器";
const description =
  "橙墨 orangeink —— 单文件公众号排版器。Markdown 进，合规富文本出；把公众号排版这件烦事，按下去一个按钮。";

const shots = [
  { src: "/orangeink-shot-1.jpg", alt: "橙墨排版成品示例：文章头部" },
  { src: "/orangeink-shot-2.jpg", alt: "橙墨排版成品示例：正文引用块" },
  { src: "/orangeink-shot-3.jpg", alt: "橙墨排版成品示例：参考与致谢" },
];

// 版本记录：与仓库 CHANGELOG.md 保持同步（精简版，细节链到仓库）
const changelog = [
  {
    ver: "v1.0.1",
    date: "2026-09-19",
    note: "自检器新增「加粗/斜体未生效」检测；页脚版本与元信息升级。",
  },
  {
    ver: "v1.0.0",
    date: "2026-09-16",
    note: "首个开源版本：结构合规自检器、一键复制零「结构异常」、四套主题、四个结构化模块、被动脚注。",
  },
];

// 后续方向：精选自仓库 ROADMAP.md（每条「缓/不纳入」都有理由）
const roadmap = [
  { name: "第二批结构化模块", status: "待社区反馈", note: "cards / metrics / 左右对比等，等真实需求出现再定" },
  { name: "HTML → Markdown 导入", status: "社区票", note: "独立小功能，谁需要谁提 issue" },
  { name: "图片能力（上传 / 图床）", status: "缓", note: "公众号外链图会被转存、防盗链，体验不可控" },
  { name: "直接发草稿箱", status: "受阻", note: "公众号已收回个人号 API 发布权限，待条件具备再评估" },
];
---

<Base title={title} description={description}>
  <article class="product">
    <header class="product-head">
      <span class="orange-bar" aria-hidden="true"></span>
      <div class="head-row">
        <h1 class="product-name">橙墨 <span class="en">orangeink</span></h1>
        <span class="status">维护中</span>
      </div>
      <p class="tagline">
        单文件公众号排版器。Markdown 进，合规富文本出；把公众号排版这件烦事，按下去一个按钮。
      </p>
      <div class="actions">
        <a class="btn" href="/orangeink.html" target="_blank" rel="noopener">
          在线使用 ↗
        </a>
        <a class="btn btn-primary" href="/orangeink.html" download>
          下载 orangeink.html
        </a>
        <a
          class="btn"
          href="https://github.com/aladooo/orangeink"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </header>

    <section class="shots">
      <h2 class="section-title">界面截图</h2>
      <figure class="ui-shot">
        <img
          src="/orangeink-ui.png"
          alt="橙墨界面：左侧 Markdown 编辑，右侧实时预览，一键复制到公众号"
          fetchpriority="high"
          width="1742"
          height="944"
        />
      </figure>
    </section>

    <section class="shots">
      <h2 class="section-title">排版成品示例</h2>
      <div class="shot-grid">
        {shots.map((shot) => (
          <figure class="shot">
            <img src={shot.src} alt={shot.alt} loading="lazy" width="405" height="720" />
          </figure>
        ))}
      </div>
      <p class="shot-note">
        以上为橙墨输出的公众号排版成品（移动端视图）。
      </p>
    </section>

    <section class="brief">
      <h2 class="section-title">它是什么</h2>
      <ul class="points">
        <li><strong>单文件 HTML</strong>：下载即用，无需安装，双击打开。</li>
        <li><strong>Markdown 进</strong>：左侧写 Markdown，所见即所得。</li>
        <li><strong>合规富文本出</strong>：一键复制到公众号编辑器，格式合规、过审烦恼少。</li>
        <li><strong>开源</strong>：源码与更新见 <a
          href="https://github.com/aladooo/orangeink"
          target="_blank"
          rel="noopener noreferrer">GitHub 仓库</a>。</li>
      </ul>
    </section>

    <section class="changelog">
      <h2 class="section-title">版本记录</h2>
      <ol class="ver-list">
        {changelog.map((item) => (
          <li class="ver-item">
            <span class="ver-badge">{item.ver}</span>
            <span class="ver-date">{item.date}</span>
            <span class="ver-note">{item.note}</span>
          </li>
        ))}
      </ol>
      <p class="see-more">
        完整更新记录见 <a
          href="https://github.com/aladooo/orangeink/blob/main/CHANGELOG.md"
          target="_blank"
          rel="noopener noreferrer">CHANGELOG.md</a>，历史版本可在 <a
          href="https://github.com/aladooo/orangeink/releases"
          target="_blank"
          rel="noopener noreferrer">Releases</a> 下载。检查手里的版本是否最新：<a
          href="/orangeink/version/">版本页</a>（工具自动检查用
        <a href="/orangeink/version.json"><code>version.json</code></a>）。
      </p>
    </section>

    <section class="roadmap">
      <h2 class="section-title">后续方向</h2>
      <ul class="rd-list">
        {roadmap.map((item) => (
          <li class="rd-item">
            <span class="rd-name">{item.name}</span>
            <span class={`rd-status rd-${item.status === "待社区反馈" ? "wait" : item.status === "社区票" ? "vote" : "hold"}`}>{item.status}</span>
            <span class="rd-note">{item.note}</span>
          </li>
        ))}
      </ul>
      <p class="see-more">
        以上是精选，完整决策记录见 <a
          href="https://github.com/aladooo/orangeink/blob/main/ROADMAP.md"
          target="_blank"
          rel="noopener noreferrer">ROADMAP.md</a>；想要某个功能，欢迎去仓库提 <a
          href="https://github.com/aladooo/orangeink/issues"
          target="_blank"
          rel="noopener noreferrer">issue</a>。
      </p>
    </section>
  </article>
</Base>

<style>
  .product-head {
    padding-bottom: 28px;
  }

  .head-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .product-name {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
  }

  .en {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.72em;
    margin-left: 4px;
  }

  .status {
    font-size: 12px;
    padding: 2px 10px;
    border-radius: 99px;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .tagline {
    color: var(--muted);
    margin: 12px 0 20px;
    max-width: 620px;
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 9px 20px;
    border-radius: 8px;
    border: 1px solid var(--ink);
    font-weight: 600;
    font-size: 0.92rem;
    transition: all 0.15s ease;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    background: #e65100;
    border-color: #e65100;
    color: #fff;
  }

  .section-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.08em;
    margin: 0 0 14px;
  }

  .shots {
    margin-bottom: 40px;
  }

  .ui-shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--card-bg);
  }

  .ui-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--card-bg);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot-note {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .points {
    margin: 0;
    padding-left: 20px;
  }

  .points li {
    margin-bottom: 8px;
  }

  .points a:hover {
    color: var(--accent);
  }

  .changelog,
  .roadmap {
    margin-bottom: 56px;
  }

  /* 版本时间线 */
  .ver-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ver-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  .ver-item:first-child {
    padding-top: 0;
  }

  .ver-badge {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-title);
    background: var(--module);
    border-radius: 6px;
    padding: 2px 10px;
    flex-shrink: 0;
  }

  .ver-date {
    color: var(--faint);
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .ver-note {
    color: var(--ink);
    font-size: 0.95rem;
  }

  /* 后续方向 */
  .rd-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rd-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  .rd-item:first-child {
    padding-top: 0;
  }

  .rd-name {
    font-weight: 600;
    color: var(--ink-title);
  }

  .rd-status {
    font-size: 12px;
    padding: 1px 10px;
    border-radius: 99px;
    flex-shrink: 0;
  }

  .rd-wait {
    background: var(--module);
    color: var(--faint);
    font-weight: 600;
  }

  .rd-vote {
    border: 1px dashed var(--border);
    color: var(--muted);
  }

  .rd-hold {
    background: var(--border);
    color: var(--muted);
  }

  .rd-note {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .see-more {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .see-more a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .shot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
