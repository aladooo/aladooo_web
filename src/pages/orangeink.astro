---
import Base from "../layouts/Base.astro";

const title = "橙墨 orangeink · 单文件公众号排版器";
const description =
  "橙墨 orangeink —— 单文件公众号排版器。Markdown 进，合规富文本出；把公众号排版这件烦事，按下去一个按钮。";

const shots = [
  { src: "/orangeink-shot-1.jpg", alt: "橙墨排版成品示例：文章头部" },
  { src: "/orangeink-shot-2.jpg", alt: "橙墨排版成品示例：正文引用块" },
  { src: "/orangeink-shot-3.jpg", alt: "橙墨排版成品示例：参考与致谢" },
];
---

<Base title={title} description={description}>
  <article class="product">
    <header class="product-head">
      <span class="orange-bar" aria-hidden="true"></span>
      <div class="head-row">
        <h1 class="product-name">橙墨 <span class="en">orangeink</span></h1>
        <span class="status">维护中</span>
      </div>
      <p class="tagline">
        单文件公众号排版器。Markdown 进，合规富文本出；把公众号排版这件烦事，按下去一个按钮。
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/orangeink.html" download>
          下载 orangeink.html
        </a>
        <a
          class="btn"
          href="https://github.com/aladooo/orangeink"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub ↗
        </a>
      </div>
    </header>

    <section class="shots">
      <h2 class="section-title">界面截图</h2>
      <figure class="ui-shot">
        <img
          src="/orangeink-ui.png"
          alt="橙墨界面：左侧 Markdown 编辑，右侧实时预览，一键复制到公众号"
          fetchpriority="high"
          width="1742"
          height="944"
        />
      </figure>
    </section>

    <section class="shots">
      <h2 class="section-title">排版成品示例</h2>
      <div class="shot-grid">
        {shots.map((shot) => (
          <figure class="shot">
            <img src={shot.src} alt={shot.alt} loading="lazy" width="405" height="720" />
          </figure>
        ))}
      </div>
      <p class="shot-note">
        以上为橙墨输出的公众号排版成品（移动端视图）。
      </p>
    </section>

    <section class="brief">
      <h2 class="section-title">它是什么</h2>
      <ul class="points">
        <li><strong>单文件 HTML</strong>：下载即用，无需安装，双击打开。</li>
        <li><strong>Markdown 进</strong>：左侧写 Markdown，所见即所得。</li>
        <li><strong>合规富文本出</strong>：一键复制到公众号编辑器，格式合规、过审烦恼少。</li>
        <li><strong>开源</strong>：源码与更新见 <a
          href="https://github.com/aladooo/orangeink"
          target="_blank"
          rel="noopener noreferrer">GitHub 仓库</a>。</li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .product-head {
    padding-bottom: 28px;
  }

  .head-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  .product-name {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
  }

  .en {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.72em;
    margin-left: 4px;
  }

  .status {
    font-size: 12px;
    padding: 2px 10px;
    border-radius: 99px;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .tagline {
    color: var(--muted);
    margin: 12px 0 20px;
    max-width: 620px;
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 9px 20px;
    border-radius: 8px;
    border: 1px solid var(--ink);
    font-weight: 600;
    font-size: 0.92rem;
    transition: all 0.15s ease;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    background: #e65100;
    border-color: #e65100;
    color: #fff;
  }

  .section-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 14px;
  }

  .shots {
    margin-bottom: 40px;
  }

  .ui-shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--card-bg);
  }

  .ui-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--card-bg);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot-note {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .points {
    margin: 0;
    padding-left: 20px;
  }

  .points li {
    margin-bottom: 8px;
  }

  .points a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .shot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
